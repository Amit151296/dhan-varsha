# Database
DATABASE_URL=postgresql://dhanvarsha:dhanvarsha123@localhost:5432/dhanvarsha

# JWT auth
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO

# --- Screener.in sector analyser ---------------------------------------------
# "session_cookie" is the only implementation today: it replays a logged-in
# browser session's csrftoken/sessionid cookies instead of calling a paid API.
# When an official screener.in API is available, add a new fetcher class in
# backend/app/services/screener/fetcher.py and point this at it.
SCREENER_DATA_SOURCE=session_cookie
SCREENER_REQUEST_TIMEOUT_SECONDS=15
SCREENER_MIN_EXPECTED_COLUMNS=19

# Add one SCREENER_SESSION_<n>_CSRF / _SID pair per logged-in screener.in
# account, numbered contiguously starting at 1. Multiple accounts are merged
# because a single free account doesn't expose every column in the
# compare/export table. Get these two values from your browser's dev tools
# (Application -> Cookies -> screener.in) after logging in.
SCREENER_SESSION_1_CSRF=
SCREENER_SESSION_1_SID=
SCREENER_SESSION_2_CSRF=
SCREENER_SESSION_2_SID=
